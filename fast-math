#!/usr/bin/env bash
# Runs python3 with the fast-math package and its native library resolved.
# Works from the development tree (library in build/) and from a published
# tree (library in lib/), so one launcher serves both.
#
# --find, --index, and --help are answered by fast_math.__main__ instead of
# being handed to python3, because the first thing a stuck session types is
# the thing it should get an answer from.
set -euo pipefail

root="$(unset CDPATH; cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"

if [[ -z "${FAST_MATH_LIBRARY:-}" ]]; then
  for candidate in \
    "$root/lib/libfast_math.so" \
    "$root/build/libfast_math.so" \
    "$root/build/libfast_math.dylib" \
    "$root/build/fast_math.dll"
  do
    if [[ -f "$candidate" ]]; then
      FAST_MATH_LIBRARY="$candidate"
      break
    fi
  done
fi

if [[ -z "${FAST_MATH_LIBRARY:-}" || ! -f "$FAST_MATH_LIBRARY" ]]; then
  printf 'fast-math: native library is not built; run make test in %s\n' "$root" >&2
  exit 1
fi

export FAST_MATH_LIBRARY
export LAMBDA_FAST_LIBRARY="${LAMBDA_FAST_LIBRARY:-$FAST_MATH_LIBRARY}"
export PYTHONPATH="$root/python${PYTHONPATH:+:$PYTHONPATH}"

case "${1:-}" in
  --find | --index | --help | -h)
    exec python3 -m fast_math "$@"
    ;;
esac

exec python3 "$@"
